<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_surface"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">
    <TextClock
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/today_widget_text"
        android:textSize="28sp" />
    <TextClock
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="@string/widget_date_format"
        android:format24Hour="@string/widget_date_format"
        android:maxLines="1"
        android:textColor="@color/today_widget_quiet"
        android:textSize="12sp" />
</LinearLayout>
