    <string name="guide">Guide</string>
    <string name="guide_summary">Learn how to use Enyo, step by step</string>
    <string name="guide_intro">This guide explains Enyo from the start. Each chapter builds on the one before, so you can read it front to back or jump to what you need.</string>
    <string name="guide_start">Start</string>
    <string name="guide_chapter">Chapter %1$d of %2$d</string>
    <string name="guide_previous">Previous</string>
    <string name="guide_next">Next</string>
